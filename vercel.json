{
  "cleanUrls": true,
  "redirects": [
    { "source": "/_files/:path*", "destination": "/#menu", "permanent": true },
    { "source": "/:path((?!menu/|index).+)", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/menu/(.*)\\.pdf", "headers": [ { "key": "Content-Type", "value": "application/pdf" }, { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
